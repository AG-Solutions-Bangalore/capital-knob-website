# CapitalKnob — Apache perf headers (cPanel / shared hosting).
# All blocks are <IfModule>-guarded: inert on Nginx/Netlify/Vercel and
# never 500s when a module is missing. Netlify-style hosts use `_headers`.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Serve pre-compressed Brotli / Gzip (Vite emits .br + .gz at build).
  #    Without this the server ships 260KB HTML + 99KB CSS raw — the main
  #    reason production PageSpeed trails local runs on Slow 4G.
  #    Internal rewrite only (URL stays clean), skip if already compressed.
  RewriteCond %{REQUEST_URI} !\.(br|gz)$ [NC]
  RewriteCond %{HTTP:Accept-Encoding} br [NC]
  RewriteCond %{REQUEST_FILENAME}\.br -s
  RewriteRule ^(.*)$ $1\.br [L,E=SERVED_BR:1]

  RewriteCond %{REQUEST_URI} !\.(br|gz)$ [NC]
  RewriteCond %{HTTP:Accept-Encoding} gzip [NC]
  RewriteCond %{REQUEST_FILENAME}\.gz -s
  RewriteRule ^(.*)$ $1\.gz [L,E=SERVED_GZ:1]

  # 2. Cache buckets via env flags (LocationMatch is illegal in .htaccess).
  RewriteRule ^assets/ - [E=IMMUTABLE:1]
  RewriteRule ^(fonts|images)/ - [E=STATIC30:1]
</IfModule>

<IfModule mod_mime.c>
  # Compound-extension mapping so x.js.br -> JS + br (same for gzip).
  AddEncoding br .br
  AddEncoding gzip .gz
  AddType application/javascript .js
  AddType text/css .css
  AddType application/json .json
  AddType text/html .html
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  # Caches must key on encoding, or CDNs poison br/gzip variants.
  Header append Vary Accept-Encoding env=SERVED_BR
  Header append Vary Accept-Encoding env=SERVED_GZ

  # Hashed Vite assets: immutable 1 year (fixes "efficient cache lifetimes").
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE
  # Un hashed static: fonts, images, logos — 30 days.
  Header set Cache-Control "public, max-age=2592000, immutable" env=STATIC30
  # Prerendered HTML: fresh each deploy, revalidate hourly.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "^(logo-.*\.webp|favicon\.ico|apple-touch-icon\.png|robots\.txt)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>
