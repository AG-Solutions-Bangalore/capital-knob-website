# Copy to `.env` and adjust per environment. Vite only exposes `VITE_*` vars.
VITE_API_BASE_URL=http://capitalknob.com/crmapi/public/api
# Optional: override derived image hosts (default: <API_BASE_URL without /api>/assets/images/...).
# For https production, prefer setting VITE_API_BASE_URL to the https endpoint —
# image URLs follow it automatically.
# VITE_IMAGE_BASE_URL=https://capitalknob.com/crmapi/public/assets/images/web_images
# VITE_BLOG_IMAGE_BASE_URL=https://capitalknob.com/crmapi/public/assets/images/blog_images
# Optional auth header value sent as `Authorization` on every API request.
# VITE_SECRET_KEY=
